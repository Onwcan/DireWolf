{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:direwolf:schema:common:envelope:1",
  "title": "DireWolf envelope v1",
  "description": "The common envelope with every optional field permitted. Each message schema narrows it; this document is the reference for field formats.",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "x-direwolf-type": "Version"
    },
    "id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "type": {
      "type": "string",
      "enum": ["request", "response", "event"],
      "x-direwolf-type": "MessageType"
    },
    "schema": {
      "type": "string",
      "maxLength": 128,
      "x-direwolf-type": "SchemaName",
      "pattern": "^direwolf(\\.[a-z][a-z0-9_]{0,31}){1,6}$"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "x-direwolf-type": "Version"
    },
    "ts": {
      "type": "string",
      "maxLength": 24,
      "x-direwolf-type": "Timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "x-direwolf-format": "rfc3339-utc-millis"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "causation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "session_id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^ses_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "SessionId",
      "x-direwolf-format": "uuid7-id",
      "x-direwolf-id-prefix": "ses"
    },
    "run_id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "RunId",
      "x-direwolf-format": "uuid7-id",
      "x-direwolf-id-prefix": "run"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "x-direwolf-type": "Epoch"
    },
    "idempotency_key": {
      "type": "string",
      "maxLength": 128,
      "x-direwolf-type": "IdempotencyKey",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": ["v", "id", "type", "schema", "schema_version", "ts", "payload"],
  "dependentRequired": {
    "epoch": ["session_id"]
  },
  "x-direwolf-envelope-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-id-prefixes": {
    "request": "msg",
    "response": "msg",
    "event": "evt"
  },
  "$defs": {}
}

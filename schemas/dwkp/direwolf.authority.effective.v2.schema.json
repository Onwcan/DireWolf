{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:direwolf:schema:dwkp:direwolf.authority.effective:2",
  "title": "direwolf.authority.effective v2",
  "description": "A run's effective authority, and a decision if one was asked for.",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-direwolf-type": "Version"
    },
    "id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^msg_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "MessageId",
      "x-direwolf-format": "uuid7-id",
      "x-direwolf-id-prefix": "msg"
    },
    "type": {
      "const": "response",
      "x-direwolf-type": "MessageType"
    },
    "schema": {
      "const": "direwolf.authority.effective",
      "x-direwolf-type": "SchemaName"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2,
      "x-direwolf-type": "Version"
    },
    "ts": {
      "type": "string",
      "maxLength": 24,
      "x-direwolf-type": "Timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "x-direwolf-format": "rfc3339-utc-millis"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "causation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "payload": {
      "$ref": "#/$defs/EffectiveAuthority"
    }
  },
  "required": ["v", "id", "type", "schema", "schema_version", "ts", "causation_id", "payload"],
  "additionalProperties": false,
  "not": {
    "anyOf": [
      {
        "required": ["session_id"]
      },
      {
        "required": ["run_id"]
      },
      {
        "required": ["epoch"]
      },
      {
        "required": ["idempotency_key"]
      }
    ]
  },
  "x-direwolf-family": "dwkp",
  "x-direwolf-message-type": "response",
  "x-direwolf-schema": "direwolf.authority.effective",
  "x-direwolf-schema-versions": {
    "min": 2,
    "max": 2
  },
  "x-direwolf-envelope-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-envelope": {
    "correlation_id": "optional",
    "causation_id": "required",
    "session_id": "forbidden",
    "run_id": "forbidden",
    "epoch": "forbidden",
    "idempotency_key": "forbidden"
  },
  "x-direwolf-id-prefix": "msg",
  "x-direwolf-unknown-fields": "reject",
  "x-direwolf-payload": "EffectiveAuthority",
  "$defs": {
    "AuthorityDecision": {
      "type": "object",
      "description": "One authority decision, with everything needed to explain it.\n\nNever a bare boolean. POLICY.md §1.5 requires the matched rule, its\nsource and the capability that was required, because a denial nobody can\ndebug is a denial someone will route around.",
      "properties": {
        "effect": {
          "type": "string",
          "enum": ["ALLOW", "DENY"],
          "x-direwolf-type": "DecisionEffect",
          "description": "What was decided."
        },
        "reason": {
          "type": "string",
          "enum": ["ALLOWED_BY_RULE", "DENIED_BY_RULE", "DEFAULT_DENY", "NO_CAPABILITY"],
          "x-direwolf-type": "DecisionReason",
          "description": "Why, as a classifiable code rather than prose."
        },
        "capability_result": {
          "type": "string",
          "enum": ["SATISFIED", "NOT_SATISFIED"],
          "x-direwolf-type": "GateResult",
          "description": "Whether a held capability covers the action (ADR-0006 gate one)."
        },
        "policy_result": {
          "type": "string",
          "enum": ["SATISFIED", "NOT_SATISFIED"],
          "x-direwolf-type": "GateResult",
          "description": "Whether policy permits it (ADR-0006 gate two). Both gates always\nrun: an ALLOW needs both, and neither substitutes for the other."
        },
        "rule_id": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "RuleId",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "description": "The id of the rule that produced the effect: the matched rule, the\nnarrowing postcondition, or the policy's own mandatory `default`\nrule when nothing matched before it. Never a stand-in for a rule\nthat did not run (ADR-0040)."
        },
        "rule_source": {
          "type": "string",
          "maxLength": 256,
          "x-direwolf-type": "RuleSource",
          "pattern": "^[A-Za-z0-9._/-]{1,240}:[0-9]{1,8}$",
          "description": "Where that rule is written: file and line."
        },
        "required_capability": {
          "type": "string",
          "maxLength": 512,
          "x-direwolf-type": "CapabilityText",
          "pattern": "^[a-z][a-z0-9_]{0,15}\\.[a-z][a-z0-9_]{0,31}:[A-Za-z0-9._/*:@+~<>-]{1,384}(\\?[A-Za-z0-9_=,&.*/-]{1,96})?$",
          "description": "The capability the action needed. Always present: a decision is\nonly ever made about a canonical action, and every canonical action\nrequires one (ADR-0040; optional in version 1)."
        }
      },
      "required": ["effect", "reason", "capability_result", "policy_result", "rule_id", "rule_source", "required_capability"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "CapabilityGrant": {
      "type": "object",
      "description": "One capability the kernel granted, and the id it minted for it.",
      "properties": {
        "cap_id": {
          "type": "string",
          "minLength": 30,
          "maxLength": 30,
          "pattern": "^cap_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "x-direwolf-type": "CapId",
          "x-direwolf-format": "uuid7-id",
          "x-direwolf-id-prefix": "cap",
          "description": "The kernel's handle for this grant, recorded against every decision\nit covers. A request never presents one: `ToolInvoke` names a call,\nand the authority finds the covering grant itself (ADR-0043), so\nthe id proves nothing and selects nothing."
        },
        "capability": {
          "type": "string",
          "maxLength": 512,
          "x-direwolf-type": "CapabilityText",
          "pattern": "^[a-z][a-z0-9_]{0,15}\\.[a-z][a-z0-9_]{0,31}:[A-Za-z0-9._/*:@+~<>-]{1,384}(\\?[A-Za-z0-9_=,&.*/-]{1,96})?$",
          "description": "The granted capability, which may be narrower than the one asked\nfor. Never wider: that is the ⊑ invariant the kernel enforces."
        }
      },
      "required": ["cap_id", "capability"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "EffectiveAuthority": {
      "type": "object",
      "description": "What a run may do, as the kernel currently records it.",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 30,
          "maxLength": 30,
          "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "x-direwolf-type": "RunId",
          "x-direwolf-format": "uuid7-id",
          "x-direwolf-id-prefix": "run",
          "description": "The run this describes."
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "x-direwolf-type": "Epoch",
          "description": "The epoch the answer is current at. An answer is about a moment."
        },
        "policy_revision": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "PolicyRevision",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Which policy produced it."
        },
        "profile": {
          "type": "string",
          "enum": ["SAFE", "BALANCED", "POWER"],
          "x-direwolf-type": "ProfileName",
          "description": "The ceiling the run was admitted under."
        },
        "granted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityGrant"
          },
          "maxItems": 64,
          "x-direwolf-type": "BoundedList",
          "description": "What the run holds."
        },
        "withheld": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WithheldCapability"
          },
          "maxItems": 64,
          "x-direwolf-type": "BoundedList",
          "description": "What it asked for and did not get."
        },
        "decision": {
          "$ref": "#/$defs/AuthorityDecision",
          "description": "The decision for the `proposed` action, present exactly when the\nquery carried one the authority could decide. A proposal it cannot\ndecide is refused instead (`NO_CANONICAL_ACTION`), so an\n`EffectiveAuthority` answering a proposal always carries its\ndecision. A reader that asked and received none must treat the\nanswer as unusable rather than as an allow."
        }
      },
      "required": ["run_id", "epoch", "policy_revision", "profile", "granted", "withheld"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "WithheldCapability": {
      "type": "object",
      "description": "One capability that was asked for and not granted, and which term of\nthe minting expression removed it.",
      "properties": {
        "capability": {
          "type": "string",
          "maxLength": 512,
          "x-direwolf-type": "CapabilityText",
          "pattern": "^[a-z][a-z0-9_]{0,15}\\.[a-z][a-z0-9_]{0,31}:[A-Za-z0-9._/*:@+~<>-]{1,384}(\\?[A-Za-z0-9_=,&.*/-]{1,96})?$",
          "description": "The capability as requested."
        },
        "reason": {
          "type": "string",
          "enum": ["NOT_IN_AGENT_PROFILE", "NOT_IN_SKILL_SET", "NOT_IN_PARENT_GRANT", "ABOVE_PROFILE_CEILING", "DENIED_BY_POLICY", "UNRESOLVED_RESOURCE"],
          "x-direwolf-type": "WithheldReason",
          "description": "Which intersection removed it."
        }
      },
      "required": ["capability", "reason"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    }
  }
}

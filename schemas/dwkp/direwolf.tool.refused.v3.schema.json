{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:direwolf:schema:dwkp:direwolf.tool.refused:3",
  "title": "direwolf.tool.refused v3",
  "description": "A version-3 tool operation refused before any effect was authorised.",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-direwolf-type": "Version"
    },
    "id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^msg_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "MessageId",
      "x-direwolf-format": "uuid7-id",
      "x-direwolf-id-prefix": "msg"
    },
    "type": {
      "const": "response",
      "x-direwolf-type": "MessageType"
    },
    "schema": {
      "const": "direwolf.tool.refused",
      "x-direwolf-type": "SchemaName"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 3,
      "maximum": 3,
      "x-direwolf-type": "Version"
    },
    "ts": {
      "type": "string",
      "maxLength": 24,
      "x-direwolf-type": "Timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "x-direwolf-format": "rfc3339-utc-millis"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "causation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "payload": {
      "$ref": "#/$defs/ToolRefusalV3"
    }
  },
  "required": ["v", "id", "type", "schema", "schema_version", "ts", "causation_id", "payload"],
  "additionalProperties": false,
  "not": {
    "anyOf": [
      {
        "required": ["session_id"]
      },
      {
        "required": ["run_id"]
      },
      {
        "required": ["epoch"]
      },
      {
        "required": ["idempotency_key"]
      }
    ]
  },
  "x-direwolf-family": "dwkp",
  "x-direwolf-message-type": "response",
  "x-direwolf-schema": "direwolf.tool.refused",
  "x-direwolf-schema-versions": {
    "min": 3,
    "max": 3
  },
  "x-direwolf-envelope-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-envelope": {
    "correlation_id": "optional",
    "causation_id": "required",
    "session_id": "forbidden",
    "run_id": "forbidden",
    "epoch": "forbidden",
    "idempotency_key": "forbidden"
  },
  "x-direwolf-id-prefix": "msg",
  "x-direwolf-unknown-fields": "reject",
  "x-direwolf-payload": "ToolRefusalV3",
  "$defs": {
    "ToolRefusalV3": {
      "type": "object",
      "description": "A version-3 tool operation the authority would not attempt. Nothing was\nperformed and no broker was contacted.",
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["TOOL_INVOKE", "CANONICAL_PREVIEW"],
          "x-direwolf-type": "ToolOperation",
          "description": "Which operation."
        },
        "reason": {
          "type": "string",
          "enum": [
            "STALE_EPOCH",
            "UNKNOWN_RUN",
            "IDEMPOTENCY_KEY_REUSED",
            "WORKSPACE_UNBOUND",
            "ROOT_REPLACED",
            "ROOT_UNAVAILABLE",
            "UNSUPPORTED_PLATFORM",
            "PATH_OUTSIDE_WORKSPACE",
            "PATH_TRAVERSAL",
            "PATH_NOT_CANONICAL",
            "NOT_FOUND",
            "NOT_A_DIRECTORY",
            "SYMLINK",
            "MAGIC_LINK",
            "MOUNT_CROSSING",
            "NAME_MISMATCH",
            "NORMALIZATION_AMBIGUITY",
            "SPECIAL_FILE",
            "WRONG_KIND",
            "MULTIPLY_LINKED",
            "WORKSPACE_ROOT",
            "DESTINATION_EXISTS",
            "PATCH_INCONSISTENT",
            "PATCH_TOO_LARGE",
            "RACE",
            "PERMISSION_DENIED",
            "DIRECTORY_TOO_LARGE",
            "IO_ERROR",
            "EXECUTABLE_PATH_INVALID",
            "EXECUTABLE_NOT_FOUND",
            "EXECUTABLE_NOT_REGULAR",
            "EXECUTABLE_NOT_EXECUTABLE",
            "EXECUTABLE_SYMLINK_LIMIT",
            "EXECUTABLE_UNTRUSTED",
            "EXECUTABLE_TOO_LARGE",
            "SCRIPT_UNSUPPORTED",
            "NOT_NATIVE_EXECUTABLE",
            "EXECUTABLE_RACE",
            "ARGV_TOO_LARGE",
            "UNKNOWN_PROCESS"
          ],
          "x-direwolf-type": "ToolRefusalReasonV3",
          "description": "Why."
        }
      },
      "required": ["operation", "reason"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject",
      "x-direwolf-check": {
        "kind": "paired",
        "left": "operation",
        "right": "reason",
        "allowed": {
          "TOOL_INVOKE": [
            "STALE_EPOCH",
            "UNKNOWN_RUN",
            "IDEMPOTENCY_KEY_REUSED",
            "WORKSPACE_UNBOUND",
            "ROOT_REPLACED",
            "ROOT_UNAVAILABLE",
            "UNSUPPORTED_PLATFORM",
            "PATH_OUTSIDE_WORKSPACE",
            "PATH_TRAVERSAL",
            "PATH_NOT_CANONICAL",
            "NOT_FOUND",
            "NOT_A_DIRECTORY",
            "SYMLINK",
            "MAGIC_LINK",
            "MOUNT_CROSSING",
            "NAME_MISMATCH",
            "NORMALIZATION_AMBIGUITY",
            "SPECIAL_FILE",
            "WRONG_KIND",
            "MULTIPLY_LINKED",
            "WORKSPACE_ROOT",
            "DESTINATION_EXISTS",
            "PATCH_INCONSISTENT",
            "PATCH_TOO_LARGE",
            "RACE",
            "PERMISSION_DENIED",
            "DIRECTORY_TOO_LARGE",
            "IO_ERROR",
            "EXECUTABLE_PATH_INVALID",
            "EXECUTABLE_NOT_FOUND",
            "EXECUTABLE_NOT_REGULAR",
            "EXECUTABLE_NOT_EXECUTABLE",
            "EXECUTABLE_SYMLINK_LIMIT",
            "EXECUTABLE_UNTRUSTED",
            "EXECUTABLE_TOO_LARGE",
            "SCRIPT_UNSUPPORTED",
            "NOT_NATIVE_EXECUTABLE",
            "EXECUTABLE_RACE",
            "ARGV_TOO_LARGE",
            "UNKNOWN_PROCESS"
          ],
          "CANONICAL_PREVIEW": [
            "STALE_EPOCH",
            "UNKNOWN_RUN",
            "WORKSPACE_UNBOUND",
            "ROOT_REPLACED",
            "ROOT_UNAVAILABLE",
            "UNSUPPORTED_PLATFORM",
            "PATH_OUTSIDE_WORKSPACE",
            "PATH_TRAVERSAL",
            "PATH_NOT_CANONICAL",
            "NOT_FOUND",
            "NOT_A_DIRECTORY",
            "SYMLINK",
            "MAGIC_LINK",
            "MOUNT_CROSSING",
            "NAME_MISMATCH",
            "NORMALIZATION_AMBIGUITY",
            "SPECIAL_FILE",
            "WRONG_KIND",
            "MULTIPLY_LINKED",
            "WORKSPACE_ROOT",
            "DESTINATION_EXISTS",
            "PATCH_INCONSISTENT",
            "PATCH_TOO_LARGE",
            "RACE",
            "PERMISSION_DENIED",
            "DIRECTORY_TOO_LARGE",
            "IO_ERROR",
            "EXECUTABLE_PATH_INVALID",
            "EXECUTABLE_NOT_FOUND",
            "EXECUTABLE_NOT_REGULAR",
            "EXECUTABLE_NOT_EXECUTABLE",
            "EXECUTABLE_SYMLINK_LIMIT",
            "EXECUTABLE_UNTRUSTED",
            "EXECUTABLE_TOO_LARGE",
            "SCRIPT_UNSUPPORTED",
            "NOT_NATIVE_EXECUTABLE",
            "EXECUTABLE_RACE",
            "ARGV_TOO_LARGE",
            "UNKNOWN_PROCESS"
          ]
        }
      }
    }
  }
}

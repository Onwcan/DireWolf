{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:direwolf:schema:dwkp:direwolf.tool.failed:1",
  "title": "direwolf.tool.failed v1",
  "description": "An authorised invocation produced no result.",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-direwolf-type": "Version"
    },
    "id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^msg_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "MessageId",
      "x-direwolf-format": "uuid7-id",
      "x-direwolf-id-prefix": "msg"
    },
    "type": {
      "const": "response",
      "x-direwolf-type": "MessageType"
    },
    "schema": {
      "const": "direwolf.tool.failed",
      "x-direwolf-type": "SchemaName"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-direwolf-type": "Version"
    },
    "ts": {
      "type": "string",
      "maxLength": 24,
      "x-direwolf-type": "Timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "x-direwolf-format": "rfc3339-utc-millis"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "causation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "payload": {
      "$ref": "#/$defs/ToolFailure"
    }
  },
  "required": ["v", "id", "type", "schema", "schema_version", "ts", "causation_id", "payload"],
  "additionalProperties": false,
  "not": {
    "anyOf": [
      {
        "required": ["session_id"]
      },
      {
        "required": ["run_id"]
      },
      {
        "required": ["epoch"]
      },
      {
        "required": ["idempotency_key"]
      }
    ]
  },
  "x-direwolf-family": "dwkp",
  "x-direwolf-message-type": "response",
  "x-direwolf-schema": "direwolf.tool.failed",
  "x-direwolf-schema-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-envelope-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-envelope": {
    "correlation_id": "optional",
    "causation_id": "required",
    "session_id": "forbidden",
    "run_id": "forbidden",
    "epoch": "forbidden",
    "idempotency_key": "forbidden"
  },
  "x-direwolf-id-prefix": "msg",
  "x-direwolf-unknown-fields": "reject",
  "x-direwolf-payload": "ToolFailure",
  "$defs": {
    "ToolFailure": {
      "type": "object",
      "description": "An `fs.read` both gates allowed, whose intent was recorded, and which\ndid not produce a result. The audit record holds the detail; the\ncaller learns the class, which says whether retrying can help.",
      "properties": {
        "invocation_id": {
          "type": "string",
          "minLength": 30,
          "maxLength": 30,
          "pattern": "^inv_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "x-direwolf-type": "InvocationId",
          "x-direwolf-format": "uuid7-id",
          "x-direwolf-id-prefix": "inv",
          "description": "The authority's id for the invocation that failed."
        },
        "reason": {
          "type": "string",
          "enum": ["OBJECT_CHANGED", "OBJECT_UNREADABLE", "BROKER_UNAVAILABLE", "BROKER_PROTOCOL_ERROR", "BROKER_EXECUTION_ERROR"],
          "x-direwolf-type": "ToolFailureReason",
          "description": "Why."
        }
      },
      "required": ["invocation_id", "reason"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:direwolf:schema:dwkp:direwolf.tool.result:4",
  "title": "direwolf.tool.result v4",
  "description": "A version-4 invocation whose whole plan was allowed, performed, and recorded.",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-direwolf-type": "Version"
    },
    "id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^msg_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "MessageId",
      "x-direwolf-format": "uuid7-id",
      "x-direwolf-id-prefix": "msg"
    },
    "type": {
      "const": "response",
      "x-direwolf-type": "MessageType"
    },
    "schema": {
      "const": "direwolf.tool.result",
      "x-direwolf-type": "SchemaName"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 4,
      "maximum": 4,
      "x-direwolf-type": "Version"
    },
    "ts": {
      "type": "string",
      "maxLength": 24,
      "x-direwolf-type": "Timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "x-direwolf-format": "rfc3339-utc-millis"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "causation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "payload": {
      "$ref": "#/$defs/ToolResultV4"
    }
  },
  "required": ["v", "id", "type", "schema", "schema_version", "ts", "causation_id", "payload"],
  "additionalProperties": false,
  "not": {
    "anyOf": [
      {
        "required": ["session_id"]
      },
      {
        "required": ["run_id"]
      },
      {
        "required": ["epoch"]
      },
      {
        "required": ["idempotency_key"]
      }
    ]
  },
  "x-direwolf-family": "dwkp",
  "x-direwolf-message-type": "response",
  "x-direwolf-schema": "direwolf.tool.result",
  "x-direwolf-schema-versions": {
    "min": 4,
    "max": 4
  },
  "x-direwolf-envelope-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-envelope": {
    "correlation_id": "optional",
    "causation_id": "required",
    "session_id": "forbidden",
    "run_id": "forbidden",
    "epoch": "forbidden",
    "idempotency_key": "forbidden"
  },
  "x-direwolf-id-prefix": "msg",
  "x-direwolf-unknown-fields": "reject",
  "x-direwolf-payload": "ToolResultV4",
  "$defs": {
    "ActionDecision": {
      "type": "object",
      "description": "How the two gates of ADR-0006 decided one action of a plan.",
      "properties": {
        "effect": {
          "type": "string",
          "enum": ["ALLOW", "DENY"],
          "x-direwolf-type": "DecisionEffect",
          "description": "What was decided for this action."
        },
        "reason": {
          "type": "string",
          "enum": ["ALLOWED_BY_RULE", "DENIED_BY_RULE", "DEFAULT_DENY", "NO_CAPABILITY", "UNRESOLVED_POLICY_INPUT", "OBLIGATION_UNENFORCEABLE"],
          "x-direwolf-type": "FsDecisionReason",
          "description": "Why."
        },
        "capability_result": {
          "type": "string",
          "enum": ["SATISFIED", "NOT_SATISFIED"],
          "x-direwolf-type": "GateResult",
          "description": "Whether a held capability covers the action."
        },
        "policy_result": {
          "type": "string",
          "enum": ["SATISFIED", "NOT_SATISFIED"],
          "x-direwolf-type": "GateResult",
          "description": "Whether policy permits it."
        },
        "rule_id": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "RuleId",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "description": "The rule that produced the effect, or could not be evaluated."
        },
        "rule_source": {
          "type": "string",
          "maxLength": 256,
          "x-direwolf-type": "RuleSource",
          "pattern": "^[A-Za-z0-9._/-]{1,240}:[0-9]{1,8}$",
          "description": "Where that rule is written."
        }
      },
      "required": ["effect", "reason", "capability_result", "policy_result", "rule_id", "rule_source"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "ContentRevision": {
      "type": "object",
      "description": "A file revision, stated exactly: the SHA-256 of its whole content and\nits length. Objectively checkable; no timestamp, no version-control\nsystem, no claim the file cannot confirm.",
      "properties": {
        "sha256": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "ContentDigest",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the whole content."
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576,
          "x-direwolf-type": "PatchLength",
          "description": "Its length in bytes."
        }
      },
      "required": ["sha256", "length"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "ExecutableRef": {
      "type": "object",
      "description": "An executable's authority identity: where it resolved to, and what was\nthere. Two builds of the same program at the same path are two\nidentities.",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 4096,
          "x-direwolf-type": "HostPath",
          "pattern": "^/[^\\u0000]{0,4095}$",
          "description": "The canonical host path of the final object: every symlink on the\nway resolved, no symlink left on it."
        },
        "sha256": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "ContentDigest",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The SHA-256 of the file's whole content, from the descriptor the\nauthority opened and hashed."
        }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "FsDeleteResult": {
      "type": "object",
      "description": "An `fs.delete` completed: the name no longer exists.",
      "properties": {},
      "required": [],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "FsListEntry": {
      "type": "object",
      "description": "One entry of a directory listing.",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 255,
          "x-direwolf-type": "EntryName",
          "pattern": "^(?!\\.\\.?$)[^/\\u0000]{1,255}$",
          "description": "Its name: one canonical path component."
        },
        "kind": {
          "type": "string",
          "enum": ["REGULAR_FILE", "DIRECTORY", "SYMLINK", "OTHER", "UNKNOWN"],
          "x-direwolf-type": "EntryKind",
          "description": "What the directory says it is. Not followed or opened."
        }
      },
      "required": ["name", "kind"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "FsListResult": {
      "type": "object",
      "description": "What an `fs.list` returned. The broker examined the first `max_entries`\nnames in byte order; the addressable ones are listed, and the ones no\ncanonical path can name — not UTF-8, not NFC, or holding a control,\nbidi or invisible-format character — are counted and never emitted.",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FsListEntry"
          },
          "maxItems": 512,
          "x-direwolf-type": "BoundedList",
          "description": "The addressable entries, in ascending byte order."
        },
        "unaddressable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512,
          "x-direwolf-type": "EntryCount",
          "description": "How many of the examined entries could not be named."
        },
        "complete": {
          "type": "boolean",
          "description": "Whether every entry of the directory was examined."
        }
      },
      "required": ["entries", "unaddressable", "complete"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "FsMoveResult": {
      "type": "object",
      "description": "An `fs.move` completed: the source name no longer exists and the\ndestination name binds the object that was checked.",
      "properties": {},
      "required": [],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "FsPatchResult": {
      "type": "object",
      "description": "What an `fs.patch` did.",
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["APPLIED", "ALREADY_APPLIED"],
          "x-direwolf-type": "PatchOutcome",
          "description": "Whether it changed the file."
        },
        "post": {
          "$ref": "#/$defs/ContentRevision",
          "description": "The file's revision now: the patch's post revision."
        }
      },
      "required": ["outcome", "post"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "FsReadResult": {
      "type": "object",
      "description": "What an `fs.read` returned.",
      "properties": {
        "content": {
          "type": "string",
          "maxLength": 524288,
          "x-direwolf-type": "HexContent",
          "pattern": "^(?:[0-9a-f]{2})*$",
          "description": "The bytes read from the start of the file, exactly, as hexadecimal.\nAt most the call's `max_bytes`; their count is the content's\nlength, and is not repeated."
        },
        "eof_observed": {
          "type": "boolean",
          "description": "Whether the end of the file was **observed** during this read: a\nread returned no bytes before `max_bytes` were read. `false` when\nexactly `max_bytes` were read — the end was then not proven, because\nfinding it would have meant reading past the authorised bound, and\nthe broker never does (ADR-0043)."
        }
      },
      "required": ["content", "eof_observed"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "FsSearchResult": {
      "type": "object",
      "description": "What an `fs.search` returned: offsets, never content.",
      "properties": {
        "offsets": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "x-direwolf-type": "ByteCount"
          },
          "maxItems": 1024,
          "x-direwolf-type": "BoundedList",
          "description": "Every offset at which the needle starts and ends within the scanned\nbytes, overlapping occurrences included, up to `max_matches`."
        },
        "scanned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-direwolf-type": "ByteCount",
          "description": "How many bytes were scanned: at most `max_scan_bytes`, never more."
        },
        "eof_observed": {
          "type": "boolean",
          "description": "Whether the end of the file was observed within the scan."
        },
        "matches_truncated": {
          "type": "boolean",
          "description": "Whether more matches were found than were returned."
        }
      },
      "required": ["offsets", "scanned", "eof_observed", "matches_truncated"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "FsStatResult": {
      "type": "object",
      "description": "What an `fs.stat` returned, from the checked object's own descriptor.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["REGULAR_FILE", "DIRECTORY"],
          "x-direwolf-type": "StatKind",
          "description": "What the object is."
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-direwolf-type": "ByteCount",
          "description": "`st_size`: a regular file's length; for a directory, the\nfilesystem's size of the directory object, not of its contents."
        },
        "link_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-direwolf-type": "LinkCount",
          "description": "`st_nlink`."
        },
        "executable": {
          "type": "boolean",
          "description": "Whether a regular file has any execute bit. Always false for a\ndirectory."
        }
      },
      "required": ["kind", "size", "link_count", "executable"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "FsWriteResult": {
      "type": "object",
      "description": "What an `fs.write` did.",
      "properties": {
        "created": {
          "type": "boolean",
          "description": "Whether the file did not exist and was created."
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-direwolf-type": "ByteCount",
          "description": "The new content's length."
        },
        "sha256": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "ContentDigest",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The new content's SHA-256."
        }
      },
      "required": ["created", "length", "sha256"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "HttpHeader": {
      "type": "object",
      "description": "One header: a name and a value, each in its one spelling.",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "HttpHeaderName",
          "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]{1,64}$",
          "description": "The name."
        },
        "value": {
          "type": "string",
          "maxLength": 4096,
          "x-direwolf-type": "HttpHeaderValue",
          "pattern": "^(?:[!-~](?:[ -~]{0,4094}[!-~])?)?$",
          "description": "The value."
        }
      },
      "required": ["name", "value"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "NetActionDecision": {
      "type": "object",
      "description": "How the gates decided one network or injection action.",
      "properties": {
        "effect": {
          "type": "string",
          "enum": ["ALLOW", "DENY"],
          "x-direwolf-type": "DecisionEffect",
          "description": "What was decided."
        },
        "reason": {
          "type": "string",
          "enum": ["ALLOWED_BY_RULE", "DENIED_BY_RULE", "DEFAULT_DENY", "NO_CAPABILITY", "UNRESOLVED_POLICY_INPUT", "OBLIGATION_UNENFORCEABLE", "APPROVAL_REQUIRED"],
          "x-direwolf-type": "NetDecisionReason",
          "description": "Why."
        },
        "capability_result": {
          "type": "string",
          "enum": ["SATISFIED", "NOT_SATISFIED"],
          "x-direwolf-type": "GateResult",
          "description": "Whether a held capability covers the action."
        },
        "policy_result": {
          "type": "string",
          "enum": ["SATISFIED", "NOT_SATISFIED"],
          "x-direwolf-type": "GateResult",
          "description": "Whether policy permits it."
        },
        "rule_id": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "RuleId",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "description": "The rule that produced the effect, or could not be evaluated."
        },
        "rule_source": {
          "type": "string",
          "maxLength": 256,
          "x-direwolf-type": "RuleSource",
          "pattern": "^[A-Za-z0-9._/-]{1,240}:[0-9]{1,8}$",
          "description": "Where that rule is written."
        }
      },
      "required": ["effect", "reason", "capability_result", "policy_result", "rule_id", "rule_source"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "NetHop": {
      "type": "object",
      "description": "One hop of a `net.http`: where it went and what came back. No path, no\nquery, no header, no address.",
      "properties": {
        "hop": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "x-direwolf-type": "HopNumber",
          "description": "Which hop."
        },
        "host": {
          "type": "string",
          "maxLength": 253,
          "x-direwolf-type": "NetHost",
          "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.){0,15}(?![0-9]+$)(?!0x[0-9a-f]*$)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "The origin's host."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "x-direwolf-type": "NetPort",
          "description": "The origin's port."
        },
        "method": {
          "type": "string",
          "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
          "x-direwolf-type": "HttpMethod",
          "description": "The method sent."
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599,
          "x-direwolf-type": "HttpStatus",
          "description": "The status the response carried, if one arrived."
        },
        "injected": {
          "type": "boolean",
          "description": "Whether a credential was injected into this hop."
        }
      },
      "required": ["hop", "host", "port", "method", "injected"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "NetHttpResult": {
      "type": "object",
      "description": "What a `net.http` brought back: the last response's status, its kept\nheaders and its body — redacted of every configured secret value, and\ncut at the bound — and every hop.",
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599,
          "x-direwolf-type": "HttpStatus",
          "description": "The last response's status."
        },
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HttpHeader"
          },
          "maxItems": 16,
          "x-direwolf-type": "BoundedList",
          "description": "Its headers on the keep-list (`crate::wire::http`), `location` as\nthe authority canonicalised it. Never `set-cookie`."
        },
        "body": {
          "type": "string",
          "maxLength": 524288,
          "x-direwolf-type": "HexContent",
          "pattern": "^(?:[0-9a-f]{2})*$",
          "description": "Its body, as lowercase hexadecimal: at most the request's bound."
        },
        "truncated": {
          "type": "boolean",
          "description": "Whether the body was longer than what came back."
        },
        "hops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NetHop"
          },
          "maxItems": 6,
          "x-direwolf-type": "BoundedList",
          "description": "Every hop, in order."
        },
        "redirect_ended": {
          "type": "string",
          "enum": ["NOT_FOLLOWED", "REDIRECT_LIMIT", "REDIRECT_LOOP", "REDIRECT_TARGET_INVALID", "REDIRECT_WOULD_RESEND_BODY", "HOP_DENIED", "ADDRESS_BLOCKED", "ADDRESS_MIXED", "RESOLUTION_FAILED", "RESOLUTION_TIMEOUT", "BUDGET_EXHAUSTED", "REQUEST_TIMEOUT", "HOP_FAILED"],
          "x-direwolf-type": "RedirectEnd",
          "description": "Why a redirect the last response asked for was not followed."
        }
      },
      "required": ["status", "headers", "body", "truncated", "hops"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "PlannedAction": {
      "type": "object",
      "description": "One canonical action a call requires: every fact policy decided on,\nstated by the authority. The capability it required is\n`<verb>:<canonical_path>?max_bytes=<byte_count>&no_symlink_targets=true`\nfor `fs.read` and `fs.write`, and\n`<verb>:<canonical_path>?no_symlink_targets=true` for the others.",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["TARGET", "SOURCE", "DESTINATION"],
          "x-direwolf-type": "ActionRole",
          "description": "What part it plays."
        },
        "verb": {
          "type": "string",
          "enum": ["fs.read", "fs.list", "fs.stat", "fs.write", "fs.create", "fs.delete"],
          "x-direwolf-type": "FsVerb",
          "description": "The capability verb it requires."
        },
        "canonical_path": {
          "type": "string",
          "maxLength": 384,
          "x-direwolf-type": "WorkspacePath",
          "pattern": "^/[^\\u0000]{0,383}$",
          "description": "The object's canonical path: resolved beneath the pinned root, or —\nfor a vacant name — the checked parent's path and the validated\nname."
        },
        "object": {
          "type": "string",
          "enum": ["EXISTING", "VACANT"],
          "x-direwolf-type": "ObjectState",
          "description": "Whether the object existed when it was resolved."
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-direwolf-type": "ByteCount",
          "description": "The file-content bytes the action reads or writes, which is what\npolicy's `max_bytes` bounds: the request's bound for a read or a\nscan, the content's length for a write, zero for metadata and names."
        },
        "decision": {
          "$ref": "#/$defs/ActionDecision",
          "description": "Both gates' decision for this action."
        }
      },
      "required": ["role", "verb", "canonical_path", "object", "byte_count", "decision"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "PlannedActionV4": {
      "type": "object",
      "description": "One action of a version-4 plan: exactly one of a filesystem action, a\nprocess action, a network action and an injection action.",
      "properties": {
        "fs": {
          "$ref": "#/$defs/PlannedAction",
          "description": "A filesystem action."
        },
        "process": {
          "$ref": "#/$defs/PlannedProcessAction",
          "description": "A process action."
        },
        "net": {
          "$ref": "#/$defs/PlannedNetAction",
          "description": "A network action."
        },
        "injection": {
          "$ref": "#/$defs/PlannedInjectionAction",
          "description": "A credential's injection."
        }
      },
      "required": [],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject",
      "minProperties": 1,
      "maxProperties": 1,
      "x-direwolf-check": {
        "kind": "exactly-one",
        "members": ["fs", "process", "net", "injection"]
      }
    },
    "PlannedInjectionAction": {
      "type": "object",
      "description": "The injection action of a `net.http` hop that asked for a credential:\n`secret.use:<handle>`, at exactly the hop's origin. The value is never\nstated, nor its header, nor its length.",
      "properties": {
        "handle": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "CredentialHandle",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$",
          "description": "The handle."
        },
        "host": {
          "type": "string",
          "maxLength": 253,
          "x-direwolf-type": "NetHost",

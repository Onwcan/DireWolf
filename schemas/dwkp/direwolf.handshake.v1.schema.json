{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:direwolf:schema:dwkp:direwolf.handshake:1",
  "title": "direwolf.handshake v1",
  "description": "Offer a range of envelope versions.",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-direwolf-type": "Version"
    },
    "id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^msg_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "MessageId",
      "x-direwolf-format": "uuid7-id",
      "x-direwolf-id-prefix": "msg"
    },
    "type": {
      "const": "request",
      "x-direwolf-type": "MessageType"
    },
    "schema": {
      "const": "direwolf.handshake",
      "x-direwolf-type": "SchemaName"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-direwolf-type": "Version"
    },
    "ts": {
      "type": "string",
      "maxLength": 24,
      "x-direwolf-type": "Timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "x-direwolf-format": "rfc3339-utc-millis"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "causation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "payload": {
      "$ref": "#/$defs/Handshake"
    }
  },
  "required": ["v", "id", "type", "schema", "schema_version", "ts", "payload"],
  "additionalProperties": false,
  "not": {
    "anyOf": [
      {
        "required": ["session_id"]
      },
      {
        "required": ["run_id"]
      },
      {
        "required": ["epoch"]
      },
      {
        "required": ["idempotency_key"]
      }
    ]
  },
  "x-direwolf-family": "dwkp",
  "x-direwolf-message-type": "request",
  "x-direwolf-schema": "direwolf.handshake",
  "x-direwolf-schema-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-envelope-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-envelope": {
    "correlation_id": "optional",
    "causation_id": "optional",
    "session_id": "forbidden",
    "run_id": "forbidden",
    "epoch": "forbidden",
    "idempotency_key": "forbidden"
  },
  "x-direwolf-id-prefix": "msg",
  "x-direwolf-unknown-fields": "reject",
  "x-direwolf-payload": "Handshake",
  "$defs": {
    "Handshake": {
      "type": "object",
      "description": "Opens a DWKP connection by offering a range of envelope versions. Always\nsent in envelope version 1, whatever it offers, so that any receiver can\nread the offer.",
      "properties": {
        "min_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "x-direwolf-type": "Version",
          "description": "Lowest envelope version the sender speaks."
        },
        "max_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "x-direwolf-type": "Version",
          "description": "Highest envelope version the sender speaks."
        }
      },
      "required": ["min_version", "max_version"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject",
      "x-direwolf-check": {
        "kind": "ordered",
        "low": "min_version",
        "high": "max_version"
      }
    }
  }
}

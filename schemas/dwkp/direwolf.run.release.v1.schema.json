{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:direwolf:schema:dwkp:direwolf.run.release:1",
  "title": "direwolf.run.release v1",
  "description": "End a run's authority.",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-direwolf-type": "Version"
    },
    "id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^msg_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "MessageId",
      "x-direwolf-format": "uuid7-id",
      "x-direwolf-id-prefix": "msg"
    },
    "type": {
      "const": "request",
      "x-direwolf-type": "MessageType"
    },
    "schema": {
      "const": "direwolf.run.release",
      "x-direwolf-type": "SchemaName"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-direwolf-type": "Version"
    },
    "ts": {
      "type": "string",
      "maxLength": 24,
      "x-direwolf-type": "Timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "x-direwolf-format": "rfc3339-utc-millis"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "causation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "session_id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^ses_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "SessionId",
      "x-direwolf-format": "uuid7-id",
      "x-direwolf-id-prefix": "ses"
    },
    "run_id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "RunId",
      "x-direwolf-format": "uuid7-id",
      "x-direwolf-id-prefix": "run"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "x-direwolf-type": "Epoch"
    },
    "payload": {
      "$ref": "#/$defs/ReleaseRun"
    }
  },
  "required": ["v", "id", "type", "schema", "schema_version", "ts", "session_id", "run_id", "epoch", "payload"],
  "additionalProperties": false,
  "not": {
    "anyOf": [
      {
        "required": ["idempotency_key"]
      }
    ]
  },
  "dependentRequired": {
    "epoch": ["session_id"]
  },
  "x-direwolf-family": "dwkp",
  "x-direwolf-message-type": "request",
  "x-direwolf-schema": "direwolf.run.release",
  "x-direwolf-schema-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-envelope-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-envelope": {
    "correlation_id": "optional",
    "causation_id": "optional",
    "session_id": "required",
    "run_id": "required",
    "epoch": "required",
    "idempotency_key": "forbidden"
  },
  "x-direwolf-id-prefix": "msg",
  "x-direwolf-unknown-fields": "reject",
  "x-direwolf-payload": "ReleaseRun",
  "$defs": {
    "ReleaseRun": {
      "type": "object",
      "description": "Ends a run's authority. The run is named by the envelope.\n\nCarries nothing: it can only surrender authority, and a field here would\nbe a way to say something about a run while ending it.",
      "properties": {},
      "required": [],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    }
  }
}

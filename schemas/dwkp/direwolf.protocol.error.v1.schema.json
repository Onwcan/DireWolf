{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:direwolf:schema:dwkp:direwolf.protocol.error:1",
  "title": "direwolf.protocol.error v1",
  "description": "The message did not decode. Not a policy denial.",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-direwolf-type": "Version"
    },
    "id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^msg_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "MessageId",
      "x-direwolf-format": "uuid7-id",
      "x-direwolf-id-prefix": "msg"
    },
    "type": {
      "const": "response",
      "x-direwolf-type": "MessageType"
    },
    "schema": {
      "const": "direwolf.protocol.error",
      "x-direwolf-type": "SchemaName"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-direwolf-type": "Version"
    },
    "ts": {
      "type": "string",
      "maxLength": 24,
      "x-direwolf-type": "Timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "x-direwolf-format": "rfc3339-utc-millis"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "causation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "payload": {
      "$ref": "#/$defs/ProtocolErrorPayload"
    }
  },
  "required": ["v", "id", "type", "schema", "schema_version", "ts", "payload"],
  "additionalProperties": false,
  "not": {
    "anyOf": [
      {
        "required": ["session_id"]
      },
      {
        "required": ["run_id"]
      },
      {
        "required": ["epoch"]
      },
      {
        "required": ["idempotency_key"]
      }
    ]
  },
  "x-direwolf-family": "dwkp",
  "x-direwolf-message-type": "response",
  "x-direwolf-schema": "direwolf.protocol.error",
  "x-direwolf-schema-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-envelope-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-envelope": {
    "correlation_id": "optional",
    "causation_id": "optional",
    "session_id": "forbidden",
    "run_id": "forbidden",
    "epoch": "forbidden",
    "idempotency_key": "forbidden"
  },
  "x-direwolf-id-prefix": "msg",
  "x-direwolf-unknown-fields": "reject",
  "x-direwolf-payload": "ProtocolErrorPayload",
  "$defs": {
    "ProtocolErrorPayload": {
      "type": "object",
      "description": "The message did not decode. This is **not** a policy denial: nothing was\nevaluated, because there was nothing well-formed to evaluate.",
      "properties": {
        "code": {
          "type": "string",
          "enum": ["PROTOCOL_FRAME_EMPTY", "PROTOCOL_FRAME_TOO_LARGE", "PROTOCOL_FRAME_TRUNCATED", "PROTOCOL_CONTENT_TYPE_UNSUPPORTED", "PROTOCOL_INVALID_UTF8", "PROTOCOL_INVALID_JSON", "PROTOCOL_DUPLICATE_KEY", "PROTOCOL_NORMALIZATION_COLLISION", "PROTOCOL_MAX_DEPTH_EXCEEDED", "PROTOCOL_NUMBER_OUT_OF_DOMAIN", "PROTOCOL_VERSION_UNSUPPORTED", "PROTOCOL_UNKNOWN_OPERATION", "PROTOCOL_SCHEMA_VIOLATION"],
          "x-direwolf-type": "ErrorCode",
          "description": "Stable error code."
        },
        "violation": {
          "type": "string",
          "enum": ["UNKNOWN_FIELD", "MISSING_FIELD", "FORBIDDEN_FIELD", "WRONG_TYPE", "NULL_NOT_ALLOWED", "OUT_OF_RANGE", "TOO_LONG", "INVALID_FORMAT", "UNKNOWN_VARIANT", "TOO_MANY_ITEMS", "INCONSISTENT"],
          "x-direwolf-type": "Violation",
          "description": "Finer classification for schema and version failures."
        },
        "path": {
          "type": "string",
          "maxLength": 256,
          "x-direwolf-type": "ErrorPath",
          "pattern": "^(/[\\s\\S]*)?$",
          "description": "JSON Pointer to the failing location."
        },
        "detail": {
          "type": "string",
          "maxLength": 512,
          "x-direwolf-type": "Detail",
          "description": "Short explanation. Informational; bounded."
        },
        "supported": {
          "$ref": "#/$defs/VersionSpan",
          "description": "For version failures, the range the receiver supports."
        }
      },
      "required": ["code", "detail"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "VersionSpan": {
      "type": "object",
      "description": "A range of versions a receiver supports.",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "x-direwolf-type": "Version",
          "description": "Lowest supported version."
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "x-direwolf-type": "Version",
          "description": "Highest supported version."
        }
      },
      "required": ["min", "max"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject",
      "x-direwolf-check": {
        "kind": "ordered",
        "low": "min",
        "high": "max"
      }
    }
  }
}

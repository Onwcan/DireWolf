{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:direwolf:schema:dwkp:direwolf.run.admit:1",
  "title": "direwolf.run.admit v1",
  "description": "Ask the kernel to admit a run and mint its authority.",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-direwolf-type": "Version"
    },
    "id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^msg_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "MessageId",
      "x-direwolf-format": "uuid7-id",
      "x-direwolf-id-prefix": "msg"
    },
    "type": {
      "const": "request",
      "x-direwolf-type": "MessageType"
    },
    "schema": {
      "const": "direwolf.run.admit",
      "x-direwolf-type": "SchemaName"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-direwolf-type": "Version"
    },
    "ts": {
      "type": "string",
      "maxLength": 24,
      "x-direwolf-type": "Timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "x-direwolf-format": "rfc3339-utc-millis"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "causation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "session_id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^ses_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "SessionId",
      "x-direwolf-format": "uuid7-id",
      "x-direwolf-id-prefix": "ses"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "x-direwolf-type": "Epoch"
    },
    "idempotency_key": {
      "type": "string",
      "maxLength": 128,
      "x-direwolf-type": "IdempotencyKey",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "payload": {
      "$ref": "#/$defs/AdmitRun"
    }
  },
  "required": ["v", "id", "type", "schema", "schema_version", "ts", "session_id", "epoch", "idempotency_key", "payload"],
  "additionalProperties": false,
  "not": {
    "anyOf": [
      {
        "required": ["run_id"]
      }
    ]
  },
  "dependentRequired": {
    "epoch": ["session_id"]
  },
  "x-direwolf-family": "dwkp",
  "x-direwolf-message-type": "request",
  "x-direwolf-schema": "direwolf.run.admit",
  "x-direwolf-schema-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-envelope-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-envelope": {
    "correlation_id": "optional",
    "causation_id": "optional",
    "session_id": "required",
    "run_id": "forbidden",
    "epoch": "required",
    "idempotency_key": "required"
  },
  "x-direwolf-id-prefix": "msg",
  "x-direwolf-unknown-fields": "reject",
  "x-direwolf-payload": "AdmitRun",
  "$defs": {
    "AdmitRun": {
      "type": "object",
      "description": "Asks the kernel to admit a run and mint its authority.\n\n`requested_capabilities` is a request, not an assertion: the kernel\nintersects it with the agent profile, the skills, the parent grant and\nthe profile ceiling, and returns what survived (`CAPABILITIES.md` §4,\n`mint` step 5). Asking for more is not an error, because an error\ninvites a retry loop; it yields less, and the difference is reported.\n\nThere is no `mode`, `profile`, `workspace_sensitivity`, `taint` or\n`privacy_class` field. Those are policy inputs, and ADR-0028 makes every\npolicy input kernel-derived: a field here would be the runtime asserting\none.",
      "properties": {
        "agent_profile": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "AgentProfileName",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "description": "Which agent profile the run is for. The kernel resolves it to the\nprofile's declared capabilities; an unknown name is a denial, not a\nprotocol error."
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64,
            "x-direwolf-type": "SkillName",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "maxItems": 32,
          "x-direwolf-type": "BoundedList",
          "description": "The skills to activate. Skills only ever narrow."
        },
        "requested_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512,
            "x-direwolf-type": "CapabilityText",
            "pattern": "^[a-z][a-z0-9_]{0,15}\\.[a-z][a-z0-9_]{0,31}:[A-Za-z0-9._/*:@+~<>-]{1,384}(\\?[A-Za-z0-9_=,&.*/-]{1,96})?$"
          },
          "maxItems": 64,
          "x-direwolf-type": "BoundedList",
          "description": "The capabilities the run would like. May exceed what it can have."
        }
      },
      "required": ["agent_profile", "skills", "requested_capabilities"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    }
  }
}

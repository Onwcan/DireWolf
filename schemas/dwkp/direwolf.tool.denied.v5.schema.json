{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:direwolf:schema:dwkp:direwolf.tool.denied:5",
  "title": "direwolf.tool.denied v5",
  "description": "An action of a version-5 plan was refused; nothing was performed.",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-direwolf-type": "Version"
    },
    "id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^msg_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "MessageId",
      "x-direwolf-format": "uuid7-id",
      "x-direwolf-id-prefix": "msg"
    },
    "type": {
      "const": "response",
      "x-direwolf-type": "MessageType"
    },
    "schema": {
      "const": "direwolf.tool.denied",
      "x-direwolf-type": "SchemaName"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 5,
      "maximum": 5,
      "x-direwolf-type": "Version"
    },
    "ts": {
      "type": "string",
      "maxLength": 24,
      "x-direwolf-type": "Timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "x-direwolf-format": "rfc3339-utc-millis"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "causation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "payload": {
      "$ref": "#/$defs/ToolDenialV5"
    }
  },
  "required": ["v", "id", "type", "schema", "schema_version", "ts", "causation_id", "payload"],
  "additionalProperties": false,
  "not": {
    "anyOf": [
      {
        "required": ["session_id"]
      },
      {
        "required": ["run_id"]
      },
      {
        "required": ["epoch"]
      },
      {
        "required": ["idempotency_key"]
      }
    ]
  },
  "x-direwolf-family": "dwkp",
  "x-direwolf-message-type": "response",
  "x-direwolf-schema": "direwolf.tool.denied",
  "x-direwolf-schema-versions": {
    "min": 5,
    "max": 5
  },
  "x-direwolf-envelope-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-envelope": {
    "correlation_id": "optional",
    "causation_id": "required",
    "session_id": "forbidden",
    "run_id": "forbidden",
    "epoch": "forbidden",
    "idempotency_key": "forbidden"
  },
  "x-direwolf-id-prefix": "msg",
  "x-direwolf-unknown-fields": "reject",
  "x-direwolf-payload": "ToolDenialV5",
  "$defs": {
    "ActionDecision": {
      "type": "object",
      "description": "How the two gates of ADR-0006 decided one action of a plan.",
      "properties": {
        "effect": {
          "type": "string",
          "enum": ["ALLOW", "DENY"],
          "x-direwolf-type": "DecisionEffect",
          "description": "What was decided for this action."
        },
        "reason": {
          "type": "string",
          "enum": ["ALLOWED_BY_RULE", "DENIED_BY_RULE", "DEFAULT_DENY", "NO_CAPABILITY", "UNRESOLVED_POLICY_INPUT", "OBLIGATION_UNENFORCEABLE"],
          "x-direwolf-type": "FsDecisionReason",
          "description": "Why."
        },
        "capability_result": {
          "type": "string",
          "enum": ["SATISFIED", "NOT_SATISFIED"],
          "x-direwolf-type": "GateResult",
          "description": "Whether a held capability covers the action."
        },
        "policy_result": {
          "type": "string",
          "enum": ["SATISFIED", "NOT_SATISFIED"],
          "x-direwolf-type": "GateResult",
          "description": "Whether policy permits it."
        },
        "rule_id": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "RuleId",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "description": "The rule that produced the effect, or could not be evaluated."
        },
        "rule_source": {
          "type": "string",
          "maxLength": 256,
          "x-direwolf-type": "RuleSource",
          "pattern": "^[A-Za-z0-9._/-]{1,240}:[0-9]{1,8}$",
          "description": "Where that rule is written."
        }
      },
      "required": ["effect", "reason", "capability_result", "policy_result", "rule_id", "rule_source"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "ExecutableRef": {
      "type": "object",
      "description": "An executable's authority identity: where it resolved to, and what was\nthere. Two builds of the same program at the same path are two\nidentities.",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 4096,
          "x-direwolf-type": "HostPath",
          "pattern": "^/[^\\u0000]{0,4095}$",
          "description": "The canonical host path of the final object: every symlink on the\nway resolved, no symlink left on it."
        },
        "sha256": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "ContentDigest",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The SHA-256 of the file's whole content, from the descriptor the\nauthority opened and hashed."
        }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "ImageExecutableRef": {
      "type": "object",
      "description": "An executable in an image: the identity a sandboxed launch is decided\non. The image is content addressed and its root read-only, so the path\nnames one file in every environment made from it; the broker proves\nthat file's bytes against `sha256` before every launch.",
      "properties": {
        "image": {
          "type": "string",
          "maxLength": 71,
          "x-direwolf-type": "ImageDigest",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "The image, by content digest."
        },
        "path": {
          "type": "string",
          "maxLength": 4096,
          "x-direwolf-type": "HostPath",
          "pattern": "^/[^\\u0000]{0,4095}$",
          "description": "The path inside the image."
        },
        "sha256": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "ContentDigest",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The SHA-256 the operator's manifest pins for it."
        }
      },
      "required": ["image", "path", "sha256"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "NetActionDecision": {
      "type": "object",
      "description": "How the gates decided one network or injection action.",
      "properties": {
        "effect": {
          "type": "string",
          "enum": ["ALLOW", "DENY"],
          "x-direwolf-type": "DecisionEffect",
          "description": "What was decided."
        },
        "reason": {
          "type": "string",
          "enum": ["ALLOWED_BY_RULE", "DENIED_BY_RULE", "DEFAULT_DENY", "NO_CAPABILITY", "UNRESOLVED_POLICY_INPUT", "OBLIGATION_UNENFORCEABLE", "APPROVAL_REQUIRED"],
          "x-direwolf-type": "NetDecisionReason",
          "description": "Why."
        },
        "capability_result": {
          "type": "string",
          "enum": ["SATISFIED", "NOT_SATISFIED"],
          "x-direwolf-type": "GateResult",
          "description": "Whether a held capability covers the action."
        },
        "policy_result": {
          "type": "string",
          "enum": ["SATISFIED", "NOT_SATISFIED"],
          "x-direwolf-type": "GateResult",
          "description": "Whether policy permits it."
        },
        "rule_id": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "RuleId",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "description": "The rule that produced the effect, or could not be evaluated."
        },
        "rule_source": {
          "type": "string",
          "maxLength": 256,
          "x-direwolf-type": "RuleSource",
          "pattern": "^[A-Za-z0-9._/-]{1,240}:[0-9]{1,8}$",
          "description": "Where that rule is written."
        }
      },
      "required": ["effect", "reason", "capability_result", "policy_result", "rule_id", "rule_source"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "PlannedAction": {
      "type": "object",
      "description": "One canonical action a call requires: every fact policy decided on,\nstated by the authority. The capability it required is\n`<verb>:<canonical_path>?max_bytes=<byte_count>&no_symlink_targets=true`\nfor `fs.read` and `fs.write`, and\n`<verb>:<canonical_path>?no_symlink_targets=true` for the others.",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["TARGET", "SOURCE", "DESTINATION"],
          "x-direwolf-type": "ActionRole",
          "description": "What part it plays."
        },
        "verb": {
          "type": "string",
          "enum": ["fs.read", "fs.list", "fs.stat", "fs.write", "fs.create", "fs.delete"],
          "x-direwolf-type": "FsVerb",
          "description": "The capability verb it requires."
        },
        "canonical_path": {
          "type": "string",
          "maxLength": 384,
          "x-direwolf-type": "WorkspacePath",
          "pattern": "^/[^\\u0000]{0,383}$",
          "description": "The object's canonical path: resolved beneath the pinned root, or —\nfor a vacant name — the checked parent's path and the validated\nname."
        },
        "object": {
          "type": "string",
          "enum": ["EXISTING", "VACANT"],
          "x-direwolf-type": "ObjectState",
          "description": "Whether the object existed when it was resolved."
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-direwolf-type": "ByteCount",
          "description": "The file-content bytes the action reads or writes, which is what\npolicy's `max_bytes` bounds: the request's bound for a read or a\nscan, the content's length for a write, zero for metadata and names."
        },
        "decision": {
          "$ref": "#/$defs/ActionDecision",
          "description": "Both gates' decision for this action."
        }
      },
      "required": ["role", "verb", "canonical_path", "object", "byte_count", "decision"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "PlannedActionV5": {
      "type": "object",
      "description": "One action of a version-5 plan: exactly one of a filesystem action, a\nhost process action, a sandboxed launch, a network action and an\ninjection action.",
      "properties": {
        "fs": {
          "$ref": "#/$defs/PlannedAction",
          "description": "A filesystem action."
        },
        "process": {
          "$ref": "#/$defs/PlannedProcessAction",
          "description": "A host process action."
        },
        "workload": {
          "$ref": "#/$defs/PlannedWorkloadAction",
          "description": "A sandboxed launch."
        },
        "net": {
          "$ref": "#/$defs/PlannedNetAction",
          "description": "A network action."
        },
        "injection": {
          "$ref": "#/$defs/PlannedInjectionAction",
          "description": "A credential's injection."
        }
      },
      "required": [],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject",
      "minProperties": 1,
      "maxProperties": 1,
      "x-direwolf-check": {
        "kind": "exactly-one",
        "members": ["fs", "process", "workload", "net", "injection"]
      }
    },
    "PlannedInjectionAction": {
      "type": "object",
      "description": "The injection action of a `net.http` hop that asked for a credential:\n`secret.use:<handle>`, at exactly the hop's origin. The value is never\nstated, nor its header, nor its length.",
      "properties": {
        "handle": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "CredentialHandle",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$",
          "description": "The handle."
        },
        "host": {
          "type": "string",
          "maxLength": 253,
          "x-direwolf-type": "NetHost",
          "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.){0,15}(?![0-9]+$)(?!0x[0-9a-f]*$)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "The origin's host it would be injected at."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "x-direwolf-type": "NetPort",
          "description": "The origin's port."
        },
        "decision": {
          "$ref": "#/$defs/NetActionDecision",
          "description": "Both gates' decision."
        }
      },
      "required": ["handle", "host", "port", "decision"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "PlannedNetAction": {
      "type": "object",
      "description": "The network action of a `net.http` hop: `network.https:<host>:<port>`\nwith `methods=<method>`, as the authority canonicalised it. Neither the\npath nor the query is stated: the URL is named by its digest, so the\nplan says which request it is without repeating what it carries.",
      "properties": {
        "host": {
          "type": "string",
          "maxLength": 253,
          "x-direwolf-type": "NetHost",
          "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.){0,15}(?![0-9]+$)(?!0x[0-9a-f]*$)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "description": "The origin's host."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "x-direwolf-type": "NetPort",
          "description": "The origin's port."
        },
        "method": {
          "type": "string",
          "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
          "x-direwolf-type": "HttpMethod",
          "description": "The method."
        },
        "url_sha256": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "ContentDigest",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The SHA-256 of the canonical URL (`https://host:port/path?query`)."
        },
        "body_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-direwolf-type": "ByteCount",
          "description": "How many body bytes the request carries."
        },
        "decision": {
          "$ref": "#/$defs/NetActionDecision",
          "description": "Both gates' decision."
        }
      },
      "required": ["host", "port", "method", "url_sha256", "body_bytes", "decision"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "PlannedProcessAction": {
      "type": "object",
      "description": "One canonical process action: every fact policy decided on, stated by\nthe authority. The capability it required is\n`<verb>:<executable path>@<sha256>` — with\n`?argv_allowlist=<first argument>` for a launch whose first argument is\nan allowlist token.",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["TARGET", "SOURCE", "DESTINATION"],
          "x-direwolf-type": "ActionRole",
          "description": "What part it plays: always `TARGET`."
        },
        "verb": {
          "type": "string",
          "enum": ["process.exec", "process.inspect", "process.signal"],
          "x-direwolf-type": "ProcessVerb",
          "description": "The capability verb it requires."
        },
        "executable": {
          "$ref": "#/$defs/ExecutableRef",
          "description": "The executable identity it is about: for a launch, the one\nresolved and hashed now; for a status or a kill, the one the process\nwas launched as."
        },
        "process_id": {
          "type": "string",
          "minLength": 30,
          "maxLength": 30,
          "pattern": "^prc_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "x-direwolf-type": "ProcessId",
          "x-direwolf-format": "uuid7-id",
          "x-direwolf-id-prefix": "prc",
          "description": "The process, for a status or a kill."
        },
        "cwd": {
          "type": "string",
          "maxLength": 384,
          "x-direwolf-type": "WorkspacePath",
          "pattern": "^/[^\\u0000]{0,383}$",
          "description": "The working directory's canonical path, for a launch."
        },
        "arg_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128,
          "x-direwolf-type": "ArgCount",
          "description": "How many arguments follow `argv[0]`, for a launch."
        },
        "argv_sha256": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "ContentDigest",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The SHA-256 of the canonical argv — `argv[0]` and every argument —\nfor a launch: what an approval will bind (ADR-0045 §7)."
        },
        "argv_safety": {
          "type": "string",
          "enum": ["SAFE", "REINTERPRETING"],
          "x-direwolf-type": "ArgvSafetyClass",
          "description": "The kernel's classification of the arguments, for a launch."
        },
        "decision": {
          "$ref": "#/$defs/ProcessActionDecision",
          "description": "Both gates' decision for this action."
        }
      },
      "required": ["role", "verb", "executable", "decision"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "PlannedWorkloadAction": {
      "type": "object",
      "description": "One sandboxed launch, as the authority decided it: every fact policy\ndecided on (the environment is `SANDBOX`), the environment it chose,\nand the bounds it will hold the launch to. The capability it required\nis `process.exec:<path>@<sha256>` — with `?argv_allowlist=<first\nargument>` for a first argument an allowlist can name.",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["TARGET", "SOURCE", "DESTINATION"],
          "x-direwolf-type": "ActionRole",
          "description": "What part it plays: always `TARGET`."
        },
        "verb": {
          "type": "string",
          "enum": ["process.exec", "process.inspect", "process.signal"],
          "x-direwolf-type": "ProcessVerb",
          "description": "The capability verb it requires: `process.exec`."
        },
        "executable": {
          "$ref": "#/$defs/ImageExecutableRef",
          "description": "The executable, in the image."
        },
        "environment_id": {
          "type": "string",
          "minLength": 30,
          "maxLength": 30,
          "pattern": "^env_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "x-direwolf-type": "EnvironmentId",
          "x-direwolf-format": "uuid7-id",
          "x-direwolf-id-prefix": "env",
          "description": "The environment the authority chose: the run's `READY` one.\nAbsent from a denial, which needs none, and from a preview of a\nrun whose environment an invocation would prepare."
        },
        "assurance": {
          "type": "string",
          "enum": ["NONE", "PROCESS_ISOLATION", "CONTAINER_ISOLATION", "VM_ISOLATION"],
          "x-direwolf-type": "ExecutionAssurance",
          "description": "That environment's measured, effective level."
        },
        "launch": {
          "type": "string",
          "enum": ["DIRECT", "HYGIENE"],
          "x-direwolf-type": "ExecLaunch",
          "description": "How it is started."
        },
        "arg_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128,
          "x-direwolf-type": "ArgCount",
          "description": "How many arguments follow `argv[0]`, as the broker is told them:\nthe obligation's first, then the call's."
        },
        "argv_sha256": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "ContentDigest",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The SHA-256 of that argv."
        },
        "argv_safety": {
          "type": "string",
          "enum": ["SAFE", "REINTERPRETING"],
          "x-direwolf-type": "ArgvSafetyClass",
          "description": "The kernel's classification of the call's arguments: what policy\ndecided on."
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "x-direwolf-type": "ExecSeconds",
          "description": "The wall clock it will be held to."
        },
        "max_stream_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072,
          "x-direwolf-type": "ExecStreamLimit",
          "description": "How many bytes of each stream come back."
        },
        "decision": {
          "$ref": "#/$defs/ProcessActionDecision",
          "description": "Both gates' decision for this action."
        }
      },
      "required": ["role", "verb", "executable", "launch", "arg_count", "argv_sha256", "argv_safety", "timeout_seconds", "max_stream_bytes", "decision"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "ProcessActionDecision": {
      "type": "object",
      "description": "How the gates decided one process action.",
      "properties": {
        "effect": {
          "type": "string",
          "enum": ["ALLOW", "DENY"],
          "x-direwolf-type": "DecisionEffect",
          "description": "What was decided."
        },
        "reason": {
          "type": "string",
          "enum": ["ALLOWED_BY_RULE", "DENIED_BY_RULE", "DEFAULT_DENY", "NO_CAPABILITY", "UNRESOLVED_POLICY_INPUT", "OBLIGATION_UNENFORCEABLE", "HOST_EXECUTION_DISABLED", "APPROVAL_REQUIRED"],
          "x-direwolf-type": "ProcessDecisionReason",
          "description": "Why."
        },
        "capability_result": {
          "type": "string",
          "enum": ["SATISFIED", "NOT_SATISFIED"],
          "x-direwolf-type": "GateResult",
          "description": "Whether a held capability covers the action."
        },
        "policy_result": {
          "type": "string",
          "enum": ["SATISFIED", "NOT_SATISFIED"],
          "x-direwolf-type": "GateResult",
          "description": "Whether policy permits it."
        },
        "rule_id": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "RuleId",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "description": "The rule that produced the effect, or could not be evaluated."
        },
        "rule_source": {
          "type": "string",
          "maxLength": 256,
          "x-direwolf-type": "RuleSource",
          "pattern": "^[A-Za-z0-9._/-]{1,240}:[0-9]{1,8}$",
          "description": "Where that rule is written."
        }
      },
      "required": ["effect", "reason", "capability_result", "policy_result", "rule_id", "rule_source"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "ToolDenialV5": {
      "type": "object",
      "description": "Every target resolved and at least one action of the plan was\nrefused. Nothing was performed and no invocation was recorded.",
      "properties": {
        "plan": {
          "$ref": "#/$defs/ToolPlanV5",
          "description": "The plan, with every action's decision."

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:direwolf:schema:dwkp:direwolf.run.grant:2",
  "title": "direwolf.run.grant v2",
  "description": "The run, the epoch and the capabilities the kernel minted.",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-direwolf-type": "Version"
    },
    "id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^msg_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "MessageId",
      "x-direwolf-format": "uuid7-id",
      "x-direwolf-id-prefix": "msg"
    },
    "type": {
      "const": "response",
      "x-direwolf-type": "MessageType"
    },
    "schema": {
      "const": "direwolf.run.grant",
      "x-direwolf-type": "SchemaName"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2,
      "x-direwolf-type": "Version"
    },
    "ts": {
      "type": "string",
      "maxLength": 24,
      "x-direwolf-type": "Timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "x-direwolf-format": "rfc3339-utc-millis"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "causation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "payload": {
      "$ref": "#/$defs/RunGrant"
    }
  },
  "required": ["v", "id", "type", "schema", "schema_version", "ts", "causation_id", "payload"],
  "additionalProperties": false,
  "not": {
    "anyOf": [
      {
        "required": ["session_id"]
      },
      {
        "required": ["run_id"]
      },
      {
        "required": ["epoch"]
      },
      {
        "required": ["idempotency_key"]
      }
    ]
  },
  "x-direwolf-family": "dwkp",
  "x-direwolf-message-type": "response",
  "x-direwolf-schema": "direwolf.run.grant",
  "x-direwolf-schema-versions": {
    "min": 2,
    "max": 2
  },
  "x-direwolf-envelope-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-envelope": {
    "correlation_id": "optional",
    "causation_id": "required",
    "session_id": "forbidden",
    "run_id": "forbidden",
    "epoch": "forbidden",
    "idempotency_key": "forbidden"
  },
  "x-direwolf-id-prefix": "msg",
  "x-direwolf-unknown-fields": "reject",
  "x-direwolf-payload": "RunGrant",
  "$defs": {
    "CapabilityGrant": {
      "type": "object",
      "description": "One capability the kernel granted, and the id it minted for it.",
      "properties": {
        "cap_id": {
          "type": "string",
          "minLength": 30,
          "maxLength": 30,
          "pattern": "^cap_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "x-direwolf-type": "CapId",
          "x-direwolf-format": "uuid7-id",
          "x-direwolf-id-prefix": "cap",
          "description": "The kernel's handle for this grant. `ToolInvoke` will name it when\nM4 gives that operation a wire form; the kernel resolves it against\nits own record, so the id proves nothing by itself."
        },
        "capability": {
          "type": "string",
          "maxLength": 512,
          "x-direwolf-type": "CapabilityText",
          "pattern": "^[a-z][a-z0-9_]{0,15}\\.[a-z][a-z0-9_]{0,31}:[A-Za-z0-9._/*:@+~<>-]{1,384}(\\?[A-Za-z0-9_=,&.*/-]{1,96})?$",
          "description": "The granted capability, which may be narrower than the one asked\nfor. Never wider: that is the ⊑ invariant the kernel enforces."
        }
      },
      "required": ["cap_id", "capability"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "RunGrant": {
      "type": "object",
      "description": "The authority the kernel minted for a run.\n\nEverything here is kernel-assigned. The run id, the epoch and every\n`cap_id` are the kernel's; the runtime cannot propose any of them.",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 30,
          "maxLength": 30,
          "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "x-direwolf-type": "RunId",
          "x-direwolf-format": "uuid7-id",
          "x-direwolf-id-prefix": "run",
          "description": "The run the kernel admitted."
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "x-direwolf-type": "Epoch",
          "description": "The epoch this grant is fenced to. A request carrying an older one\nis rejected (`PROTOCOL.md` §3)."
        },
        "policy_revision": {
          "type": "string",
          "maxLength": 64,
          "x-direwolf-type": "PolicyRevision",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Which policy was in force when the grant was minted."
        },
        "profile": {
          "type": "string",
          "enum": ["SAFE", "BALANCED", "POWER"],
          "x-direwolf-type": "ProfileName",
          "description": "The ceiling the run was admitted under."
        },
        "granted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityGrant"
          },
          "maxItems": 64,
          "x-direwolf-type": "BoundedList",
          "description": "What the run holds."
        },
        "withheld": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WithheldCapability"
          },
          "maxItems": 64,
          "x-direwolf-type": "BoundedList",
          "description": "What it asked for and did not get, so it can say so coherently."
        }
      },
      "required": ["run_id", "epoch", "policy_revision", "profile", "granted", "withheld"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    },
    "WithheldCapability": {
      "type": "object",
      "description": "One capability that was asked for and not granted, and which term of\nthe minting expression removed it.",
      "properties": {
        "capability": {
          "type": "string",
          "maxLength": 512,
          "x-direwolf-type": "CapabilityText",
          "pattern": "^[a-z][a-z0-9_]{0,15}\\.[a-z][a-z0-9_]{0,31}:[A-Za-z0-9._/*:@+~<>-]{1,384}(\\?[A-Za-z0-9_=,&.*/-]{1,96})?$",
          "description": "The capability as requested."
        },
        "reason": {
          "type": "string",
          "enum": ["NOT_IN_AGENT_PROFILE", "NOT_IN_SKILL_SET", "NOT_IN_PARENT_GRANT", "ABOVE_PROFILE_CEILING", "DENIED_BY_POLICY", "UNRESOLVED_RESOURCE"],
          "x-direwolf-type": "WithheldReason",
          "description": "Which intersection removed it."
        }
      },
      "required": ["capability", "reason"],
      "additionalProperties": false,
      "x-direwolf-unknown-fields": "reject"
    }
  }
}

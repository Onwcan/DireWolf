{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:direwolf:schema:events:direwolf.session.lease_acquired:1",
  "title": "direwolf.session.lease_acquired v1",
  "description": "The runtime acquired a session lease (a cache of a kernel fact).",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-direwolf-type": "Version"
    },
    "id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^evt_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "EventId",
      "x-direwolf-format": "uuid7-id",
      "x-direwolf-id-prefix": "evt"
    },
    "type": {
      "const": "event",
      "x-direwolf-type": "MessageType"
    },
    "schema": {
      "const": "direwolf.session.lease_acquired",
      "x-direwolf-type": "SchemaName"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "x-direwolf-type": "Version"
    },
    "ts": {
      "type": "string",
      "maxLength": 24,
      "x-direwolf-type": "Timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "x-direwolf-format": "rfc3339-utc-millis"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "causation_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[a-z]{2,8}_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "AnyId",
      "x-direwolf-format": "uuid7-id"
    },
    "session_id": {
      "type": "string",
      "minLength": 30,
      "maxLength": 30,
      "pattern": "^ses_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "x-direwolf-type": "SessionId",
      "x-direwolf-format": "uuid7-id",
      "x-direwolf-id-prefix": "ses"
    },
    "payload": {
      "$ref": "#/$defs/LeaseAcquired"
    }
  },
  "required": ["v", "id", "type", "schema", "schema_version", "ts", "session_id", "payload"],
  "not": {
    "anyOf": [
      {
        "required": ["run_id"]
      },
      {
        "required": ["epoch"]
      },
      {
        "required": ["idempotency_key"]
      }
    ]
  },
  "x-direwolf-family": "events",
  "x-direwolf-message-type": "event",
  "x-direwolf-schema": "direwolf.session.lease_acquired",
  "x-direwolf-schema-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-envelope-versions": {
    "min": 1,
    "max": 1
  },
  "x-direwolf-envelope": {
    "correlation_id": "optional",
    "causation_id": "optional",
    "session_id": "required",
    "run_id": "forbidden",
    "epoch": "forbidden",
    "idempotency_key": "forbidden"
  },
  "x-direwolf-id-prefix": "evt",
  "x-direwolf-unknown-fields": "preserve",
  "x-direwolf-payload": "LeaseAcquired",
  "$defs": {
    "LeaseAcquired": {
      "type": "object",
      "description": "The runtime acquired the lease for the session in the envelope.\n\nA **cache** of a kernel fact: the kernel assigned the epoch and holds\nthe authoritative value in `kernel.db` (ADR-0028). Where this record and\nthe kernel disagree, the kernel is right.",
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "x-direwolf-type": "Epoch",
          "description": "The epoch the kernel granted."
        }
      },
      "required": ["epoch"],
      "x-direwolf-unknown-fields": "preserve"
    }
  }
}
